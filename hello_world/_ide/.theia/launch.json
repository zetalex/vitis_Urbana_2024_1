{
	"version": "0.2.0",
	"configurations": [
		{
			"type": "tcf-debug",
			"request": "launch",
			"name": "hello_world_app_hw_remote",
			"debugType": "baremetal-fpga",
			"attachToRunningTargetOptions": {
				"targetSetupMode": "standalone",
				"executeScript": true,
				"scriptPath": ""
			},
			"autoAttachProcessChildren": false,
			"target": {
				"targetConnectionId": "Remote",
				"peersIniPath": "../../../.wsdata/.peers.ini",
				"context": "fpga"
			},
			"targetSetup": {
				"resetSystem": false,
				"programDevice": false,
				"bitstreamFile": "${workspaceFolder}/hello_world/_ide/bitstream/system_wrapper.bit",
				"downloadElf": [
					{
						"core": "microblaze_0",
						"resetProcessor": true,
						"elfFile": "${workspaceFolder}/hello_world/build/hello_world.elf",
						"stopAtEntry": false
					}
				]
			},
			"internalConsoleOptions": "openOnSessionStart"
		}
	]
}